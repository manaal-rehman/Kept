# Copy to .env (never commit .env). These are read at BUILD time only.
# Leave empty to let each user enter their own app IDs in Integrations → App setup.

# Google Cloud OAuth client, type "Desktop app" (docs/SETUP.md §4)
KEPT_GOOGLE_CLIENT_ID=
# Google issues a secret for desktop clients; per Google's own docs it is not treated as confidential
# for installed apps, but keep it out of git anyway.
KEPT_GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration, public client (docs/SETUP.md §5)
KEPT_MS_CLIENT_ID=

# Slack app with PKCE enabled (docs/SETUP.md §6)
KEPT_SLACK_CLIENT_ID=

# Logging level for troubleshooting (written to %LOCALAPPDATA%\com.kept.agent\logs)
# KEPT_LOG=debug

# Optional: run the AI extraction evaluation (synthetic data only)
# KEPT_EVAL_PROVIDER=anthropic
# KEPT_EVAL_API_KEY=
